{
  "name": "@wicklib/script",
  "version": "0.1.0-next.18",
  "description": "WickScript runtime contract (TypeScript for charts)",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "./dist/worker.js",
    "./dist/worker.cjs"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./worker": {
      "import": {
        "types": "./dist/worker.d.ts",
        "default": "./dist/worker.js"
      },
      "require": {
        "types": "./dist/worker.d.cts",
        "default": "./dist/worker.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wicklib/wicklib.git",
    "directory": "packages/script"
  },
  "peerDependencies": {
    "@wicklib/core": "^0.1.0-next.18"
  },
  "devDependencies": {
    "@wicklib/core": "workspace:*",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "quickjs-emscripten": "^0.32.0",
    "sucrase": "^3.35.1"
  }
}
