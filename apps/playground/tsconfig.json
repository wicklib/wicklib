{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@wicklib/core": ["../../packages/core/src/index.ts"],
      "@wicklib/indicators": ["../../packages/indicators/src/index.ts"],
      "@wicklib/script-editor": ["../../packages/script-editor/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "playwright.config.ts", "tests"]
}
